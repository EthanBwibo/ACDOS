#!/bin/sh
# Rejects commit messages that do not follow the six Conventional Commit types
# defined in CONTRIBUTING.md. Enable with: git config core.hooksPath .githooks

msg_file="$1"
first_line=$(head -n 1 "$msg_file")

# Let git's own generated messages through (merges, reverts, fixups).
case "$first_line" in
  Merge*|Revert*|fixup!*|squash!*) exit 0 ;;
esac

pattern='^(feat|fix|refactor|test|docs|chore)(\([a-z0-9._-]+\))?!?: .{1,72}$'

if ! printf '%s' "$first_line" | grep -Eq "$pattern"; then
  echo "commit-msg: rejected." >&2
  echo "  Got:      $first_line" >&2
  echo "  Expected: type(scope): summary" >&2
  echo "  Types:    feat fix refactor test docs chore" >&2
  echo "  Example:  feat(solver): implement Shaw removal operator" >&2
  exit 1
fi
