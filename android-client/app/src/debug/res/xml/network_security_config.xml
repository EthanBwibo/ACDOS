<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. Plain HTTP is allowed to the laptop's backend and nowhere else:
  127.0.0.1 and localhost through `adb reverse tcp:8000 tcp:8000` on a phone, 10.0.2.2
  from the emulator. Release builds have no such file and stay HTTPS-only.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
