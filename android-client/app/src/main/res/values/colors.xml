<?xml version="1.0" encoding="utf-8"?>
<!--
    Colour tokens, approved in #165. Layouts and styles read these through theme attributes
    (?attr/colorSurface), never directly. values-night/colors.xml overrides the role_ colours.
-->
<resources>
    <!-- The one accent. Same value in both themes, so it is not in values-night. It is a fill:
         #E01A22 is under 4.5:1 on dark surfaces, so text never uses it. -->
    <color name="kq_red">#E01A22</color>
    <color name="on_kq_red">#FFFFFF</color>

    <!-- "Fixed" Material roles keep their value in both themes. -->
    <color name="fixed_primary_fixed">#FDE7E9</color>
    <color name="fixed_primary_fixed_dim">#FFB3B8</color>
    <color name="fixed_on_primary_fixed">#3F0007</color>
