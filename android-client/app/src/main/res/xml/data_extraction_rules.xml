<?xml version="1.0" encoding="utf-8"?><!--
   Backup and device transfer on API 31+. Same exclusions as backup_rules.xml:
   the Supabase session and the cached profile never leave this device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="acdos_auth.xml" />
        <exclude domain="sharedpref" path="acdos_profile.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="acdos_auth.xml" />
        <exclude domain="sharedpref" path="acdos_profile.xml" />
    </device-transfer>
</data-extraction-rules>
