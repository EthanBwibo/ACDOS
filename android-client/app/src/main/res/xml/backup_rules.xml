<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup on API 30 and lower (API 31+ reads data_extraction_rules.xml).
   The Supabase session and the cached profile stay on this device: a refresh
   token restored onto another phone would sign that phone in.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="acdos_auth.xml" />
    <exclude domain="sharedpref" path="acdos_profile.xml" />
</full-backup-content>
