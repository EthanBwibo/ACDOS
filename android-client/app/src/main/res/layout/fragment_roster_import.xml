<?xml version="1.0" encoding="utf-8"?>
<!-- Import roster (issue 229): the dry run's counts and rejected rows, then the import. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/file_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.ACDOS.Secondary" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/busy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/summary_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">

                <include
                    android:id="@+id/rows_in_file"
                    layout="@layout/view_detail_row" />

                <include
                    android:id="@+id/crew_created"
                    layout="@layout/view_detail_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <include
                    android:id="@+id/crew_updated"
                    layout="@layout/view_detail_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <include
                    android:id="@+id/pickups"
                    layout="@layout/view_detail_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <include
                    android:id="@+id/rows_rejected"
                    layout="@layout/view_detail_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/locations_label"
            style="@style/Widget.ACDOS.Overline"
            android:text="@string/roster_locations_title"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/locations_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/location_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/divider_hairline"
                android:orientation="vertical"
                android:paddingVertical="4dp"
                android:showDividers="middle" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/locations_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/roster_locations_hint"
            android:textAppearance="@style/TextAppearance.ACDOS.Secondary.Small"
            android:visibility="gone" />

        <TextView
            android:id="@+id/rejected_label"
            style="@style/Widget.ACDOS.Overline"
            android:text="@string/roster_rejected_title"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/rejected_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/rejected_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/divider_hairline"
                android:orientation="vertical"
                android:paddingVertical="4dp"
                android:showDividers="middle" />

        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/import_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/retry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/action_retry"
            android:visibility="gone" />

        <Button
            android:id="@+id/other_file"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/roster_choose_other" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/roster_no_replan"
            android:textAppearance="@style/TextAppearance.ACDOS.Secondary.Small" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
