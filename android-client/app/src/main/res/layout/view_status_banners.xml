<?xml version="1.0" encoding="utf-8"?>
<!-- Under the top bar on every Crew and Dispatcher screen: offline, or a failed load. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <TextView
        android:id="@+id/offline_banner"
        style="@style/Widget.ACDOS.Banner.Offline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/load_error"
        style="@style/Widget.ACDOS.Banner.Error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

</merge>
