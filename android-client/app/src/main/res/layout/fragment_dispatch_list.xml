<?xml version="1.0" encoding="utf-8"?>
<!-- The hub's Pickups and Vehicles lists. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Pickups only (issue 253): the form for one pickup, without a CSV. -->
        <Button
            android:id="@+id/add_pickup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/add_pickup"
            android:visibility="gone" />

        <!-- Pickups only (issue 229): opens the file picker for a roster CSV. -->
        <Button
            android:id="@+id/import_roster"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/roster_import"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/divider_hairline"
                android:orientation="vertical"
                android:paddingVertical="4dp"
                android:showDividers="middle" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
