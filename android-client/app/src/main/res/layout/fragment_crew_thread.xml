<?xml version="1.0" encoding="utf-8"?>
<!--
    One crew member's thread (issue 250), opened from the inbox: Figma frame 2:241
    as chat bubbles (issue 226), their messages on the left, the dispatcher's
    replies on the right, newest at the bottom. The reply presets stay under it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="16dp">

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.ACDOS.Secondary"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/conversation"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <!-- Always shown: who a reply goes to, or how to pick someone. -->
    <LinearLayout
        android:id="@+id/reply_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="8dp">

        <TextView
            style="@style/Widget.ACDOS.Overline"
            android:text="@string/dispatch_reply_presets" />

        <TextView
            android:id="@+id/reply_to"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:textAppearance="@style/TextAppearance.ACDOS.Secondary" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/reply_presets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:chipSpacingVertical="0dp" />

        <LinearLayout
            android:id="@+id/reply_presets_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/dispatch_reply_presets_failed"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorError" />

            <Button
                android:id="@+id/reply_presets_retry"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_retry" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
